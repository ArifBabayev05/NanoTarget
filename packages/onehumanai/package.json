{
  "name": "onehumanai",
  "version": "0.6.6",
  "description": "Detect AI agents (Claude in Chrome, ChatGPT agent, Codex, Comet, Playwright) inside signed-in sessions and decide per endpoint: allow, mask, passkey or block, with a signed proof a human agreed. Node.js middleware + browser SDK. npx onehumanai init",
  "type": "module",
  "license": "(Apache-2.0 AND BUSL-1.1)",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./sdk": "./sdk/onehuman.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/integrations/express/index.d.ts",
  "bin": {
    "onehumanai": "dist/cli.js"
  },
