{
  "name": "onehumanai",
  "version": "0.6.3",
  "description": "When a customer sends an AI agent (Claude in Chrome, ChatGPT agent, Codex, Comet, Playwright…) into your product, decide what it may do on their behalf — allow · mask · step-up · block, per endpoint, on your own server — and keep a signed proof that a human agreed. One package: Express/Connect middleware, browser SDK, engine and CLI. `npm i onehumanai`, then `npx onehumanai init`. AI coding agents: the README is your integration protocol.",
  "type": "module",
  "license": "(Apache-2.0 AND BUSL-1.1)",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./sdk": "./sdk/onehuman.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/integrations/express/index.d.ts",
  "bin": {
    "onehumanai": "dist/cli.js"
  },
  "files": [
    "dist",
    "sdk",
    "README.md",
    "QUICKSTART.md",
    "AGENTS.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-BSL",
    "NOTICE"
  ],
  "keywords": [
    "ai-agent",
    "browser-agent",
    "bot-detection",
    "agentic-browser",
    "express",
    "middleware",
    "session-security",
    "claude",
    "chatgpt-agent",
    "web-bot-auth",
    "ai-security",
    "prompt-injection",
    "data-exfiltration",
    "pii-masking",
    "webauthn",
    "passkey",
    "agentic-ai",
    "agent-detection",
    "ai-browser-agent",
    "decision-proof",
    "audit",
    "onehuman"
  ],
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@libsql/client": "^0.18.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneHumanAI/onehumanai.git"
  },
  "homepage": "https://onehuman.ai",
  "bugs": {
    "url": "https://github.com/OneHumanAI/onehumanai/issues"
  },
  "author": "OneHuman <founders@onehuman.ai>"
}
