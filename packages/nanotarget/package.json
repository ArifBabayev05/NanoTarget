{
  "name": "nanotarget",
  "version": "0.3.1",
  "description": "Server-side control over AI browser agents inside your users' logged-in sessions. Detects the moment Claude in Chrome, ChatGPT/Atlas, Codex, Comet or a Playwright driver attaches, tells hands from programs by pointer physics, redacts what is already on screen, and decides allow/mask/step-up/block per endpoint with a passkey way back. Express middleware + browser SDK + `npx nanotarget scan`. AI coding agents: the README is your integration protocol — threat model, exposure map, decision matrix, mask cookbook, nine decisions, verification.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./express": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./sdk": "./sdk/nanotarget.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/integrations/express/index.d.ts",
  "files": [
    "dist",
    "sdk",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "ai-agent",
    "browser-agent",
    "bot-detection",
    "agentic-browser",
    "express",
    "middleware",
    "session-security",
    "claude",
    "chatgpt-agent",
    "web-bot-auth",
    "ai-security",
    "prompt-injection",
    "data-exfiltration",
    "pii-masking",
    "webauthn",
    "passkey",
    "agentic-ai"
  ],
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "sideEffects": false,
  "bin": {
    "nanotarget": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArifBabayev05/NanoTarget.git"
  },
  "homepage": "https://nanotarget-mvp.vercel.app",
  "bugs": {
    "url": "https://github.com/ArifBabayev05/NanoTarget/issues"
  },
  "author": "Arif Babayev",
  "dependencies": {
    "nanotarget-engine": "0.3.1"
  }
}
