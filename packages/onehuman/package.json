{
  "name": "onehuman",
  "version": "0.6.0",
  "description": "Know the moment an AI agent (Claude in Chrome, ChatGPT Atlas, Codex, Comet, Playwright\u2026) takes over a signed-in session \u2014 on your own server \u2014 and decide per endpoint what it may see: allow \u00b7 mask \u00b7 step-up \u00b7 block, with a passkey way back and a signed proof of every decision. Express/Connect middleware + browser SDK + CLI. This package is Apache-2.0 and pulls in the engine (onehuman-engine, BUSL-1.1, production use granted) automatically: `npm i onehuman` is all you install. AI coding agents: the README is your integration protocol.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./express": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./sdk": "./sdk/onehuman.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/integrations/express/index.d.ts",
  "files": [
    "dist",
    "sdk",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "ai-agent",
    "browser-agent",
    "bot-detection",
    "agentic-browser",
    "express",
    "middleware",
    "session-security",
    "claude",
    "chatgpt-agent",
    "web-bot-auth",
    "ai-security",
    "prompt-injection",
    "data-exfiltration",
    "pii-masking",
    "webauthn",
    "passkey",
    "agentic-ai",
    "agent-detection",
    "ai-browser-agent",
    "decision-proof",
    "audit",
    "apache-2.0"
  ],
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "sideEffects": false,
  "bin": {
    "onehuman": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArifBabayev05/NanoTarget.git"
  },
  "homepage": "https://onehuman.ai",
  "bugs": {
    "url": "https://github.com/ArifBabayev05/NanoTarget/issues"
  },
  "author": "Arif Babayev",
  "dependencies": {
    "onehuman-engine": "0.6.0"
  }
}
