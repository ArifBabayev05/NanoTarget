{
  "name": "@onehumanai/express",
  "version": "0.6.0",
  "description": "Know the moment an AI agent (Claude in Chrome, ChatGPT Atlas, Codex, Comet, Playwright…) takes over a signed-in session — on your own server — and decide per endpoint what it may see: allow · mask · step-up · block, with a passkey way back and a signed proof of every decision. Express/Connect middleware + browser SDK + CLI. Apache-2.0; pulls in the engine (@onehumanai/engine, BUSL-1.1, production use granted) automatically: `npm i @onehumanai/express` is all you install, `npx onehuman init` sets it up. AI coding agents: the README is your integration protocol.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/integrations/express/index.d.ts",
      "default": "./dist/express.js"
    },
    "./cli": "./dist/cli.js",
    "./sdk": "./sdk/onehuman.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/integrations/express/index.d.ts",
  "files": [
    "dist",
    "sdk",
    "README.md",
    "QUICKSTART.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "ai-agent",
    "browser-agent",
    "bot-detection",
    "agentic-browser",
    "express",
    "middleware",
    "session-security",
    "claude",
    "chatgpt-agent",
    "web-bot-auth",
    "ai-security",
    "prompt-injection",
    "data-exfiltration",
    "pii-masking",
    "webauthn",
    "passkey",
    "agentic-ai",
    "agent-detection",
    "ai-browser-agent",
    "decision-proof",
    "audit",
    "apache-2.0"
  ],
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "sideEffects": false,
  "bin": {
    "onehuman": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onehumanai/onehuman.git"
  },
  "homepage": "https://onehuman.ai",
  "bugs": {
    "url": "https://github.com/onehumanai/onehuman/issues"
  },
  "author": "OneHuman <founders@onehuman.ai>",
  "dependencies": {
    "@onehumanai/engine": "0.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
