{
  "name": "@onehuman/engine",
  "version": "0.3.1",
  "description": "The OneHuman engine: AI-agent detection, per-resource policy, hash-chained audit and signed decision proofs. Installed by the onehuman package; you rarely need it directly.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/engine.js",
  "types": "./dist/types/server/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/server/public.d.ts",
      "default": "./dist/engine.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "@libsql/client": "^0.18.0"
  },
  "homepage": "https://onehuman-mvp.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArifBabayev05/OneHuman.git"
  },
  "keywords": [
    "onehuman",
    "ai-agent",
    "agent-detection",
    "session-security"
  ]
}
